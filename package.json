{
  "name": "multiedu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "start": "npm start -w apps/server",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "dev:offline": "npm run dev -w apps/web",
    "preview": "npm run preview -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
